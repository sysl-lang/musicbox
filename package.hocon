// A music synthesizer in pure sysl: a score of notes, a fixed pool of voices, and 16-bit samples
// pulled out at whatever rate the audio device runs at.
//
// This is the block a *consumer* writes to reach this package:
//
//     dependencies {
//       musicbox { git = "github.com/sysl-lang/musicbox", version = "0.1.3" }
//     }
//
// The coordinate names the package, `musicbox`; the module a program imports is `sh.sysl.musicbox`.

package {
  name    = "musicbox"
  version = "0.1.3"

  // The oldest compiler this package has been built and tested with. A board build needs 0.0.160:
  // before it, a consumer's build also read this package's `@tests` file, which imports `sysl.fs`,
  // and so failed at a freestanding target.
  sysl    = "0.0.160"
}

// **`requires {}` is exact.** The renderer asks for no operating system, no clock, no files and no
// threads: it is handed a buffer and fills it. It carries no C, so there is no header to be missing
// on a freestanding target, and it keeps no module storage that an initializer would have to fill --
// the sine table is a literal laid straight into the object file. A board with no floating point
// still builds it; the floats are in setting a score and a synth up, and the per-sample loop is
// integer arithmetic.
//
// The one exception is `save_wav`, which writes a file, and it is marked `@needs(os)` rather than
// stated here: since sysl 0.0.159 that charges `os` at a call to it, not to every program importing
// the module, so a board that only renders still builds.
//
// The heap users are `render_wav` and `save_wav`, which grow a buffer for a whole file, and `parse`, which grows a
// score's notes. A program that calls neither never reaches the allocator, which is why the
// `parsing` dependency's own `requires { heap = true }` is not restated here.
requires {
}

// The text notation reads through the organisation's parsing toolkit.
dependencies {
  parsing { git = "github.com/sysl-lang/parsing", version = "0.10.0" }
}
